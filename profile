<!DOCTYPE html>
<html>
<head>
  <title>Chat Profile</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f2f2f2;
    }
    .profile-card {
      width: 300px;
      background: white;
      margin: 50px auto;
      border-radius: 10px;
      padding: 20px;
      text-align: center;
    }
    img {
      width: 100px;
      height: 100px;
      border-radius: 50%;
    }
    h2 {
      margin: 10px 0 5px;
    }
    .status {
      color: green;
      font-size: 14px;
    }
  </style>
</head>
<body>

<div class="profile-card">
  <img src="avatar.png" alt="Profile Picture">
  <h2>John Doe</h2>
  <p>@john_doe</p>
  <p class="status">● Online</p>
  <p>Hey! I love chatting 👋</p>
</div>

</body>
</html>
